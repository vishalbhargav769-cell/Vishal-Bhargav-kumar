<script>
/* =========================================================
   1) SHOP CONFIG — edit these
   ========================================================= */
const OWNER_EMAIL = "vishalbhargav769@gmail.com";

// EmailJS credentials — create a free account at https://www.emailjs.com
// then paste your own Public Key / Service ID / Template ID below.
// Your EmailJS template should include variables:
// {{to_email}} {{customer_name}} {{customer_phone}} {{customer_address}} {{order_items}} {{order_total}}
const EMAILJS_PUBLIC_KEY  = "YOUR_EMAILJS_PUBLIC_KEY";
const EMAILJS_SERVICE_ID  = "YOUR_EMAILJS_SERVICE_ID";
const EMAILJS_TEMPLATE_ID = "YOUR_EMAILJS_TEMPLATE_ID";

if (window.emailjs && EMAILJS_PUBLIC_KEY.indexOf("YOUR_") !== 0) {
  emailjs.init({ publicKey: EMAILJS_PUBLIC_KEY });
}

/* =========================================================
   2) PRODUCTS — swap images/names/prices for your real stock
   ========================================================= */
const PRODUCTS = [
  { id:"apples",  name:"Fresh Apples (1kg)",        price:180, img:"https://picsum.photos/seed/apples/480/480" },
  { id:"bananas", name:"Organic Bananas (dozen)",    price:60,  img:"https://picsum.photos/seed/bananas/480/480" },
  { id:"eggs",    name:"Farm Eggs (12 pcs)",         price:90,  img:"https://picsum.photos/seed/eggs/480/480" },
  { id:"bread",   name:"Whole Wheat Bread",          price:45,  img:"https://picsum.photos/seed/bread/480/480" },
  { id:"rice",    name:"Basmati Rice (5kg)",         price:620, img:"https://picsum.photos/seed/rice/480/480" },
  { id:"oil",     name:"Cold Pressed Oil (1L)",      price:210, img:"https://picsum.photos/seed/oil/480/480" },
  { id:"chai",    name:"Masala Chai Pack (250g)",    price:130, img:"https://picsum.photos/seed/chai/480/480" },
  { id:"veggies", name:"Seasonal Vegetable Box",     price:250, img:"https://picsum.photos/seed/veggies/480/480" },
];

/* =========================================================
   3) STATE
   ========================================================= */
let cart = {}; // { productId: qty }

/* =========================================================
   4) RENDER PRODUCT CAROUSEL
   ========================================================= */
const carouselEl = document.getElementById("carousel");
PRODUCTS.forEach(p => {
  const card = document.createElement("div");
  card.className = "card";
  card.innerHTML = `
    <div class="img-wrap"><img src="${p.img}" alt="${p.name}" loading="lazy"></div>
    <div class="card-body">
      <h3>${p.name}</h3>
      <div class="price-row">
        <span class="price">&#8377;${p.price}</span>
        <button class="add-btn" data-id="${p.id}">Add to cart</button>
      </div>
    </div>`;
  carouselEl.appendChild(card);
});

carouselEl.addEventListener("click", e => {
  const btn = e.target.closest(".add-btn");
  if (!btn) return;
  addToCart(btn.dataset.id);
  btn.textContent = "Added ✓";
  btn.classList.add("added");
  setTimeout(() => { btn.textContent = "Add to cart"; btn.classList.remove("added"); }, 900);
});

document.getElementById("arrowLeft").onclick  = () => carouselEl.scrollBy({left:-280, behavior:"smooth"});
document.getElementById("arrowRight").onclick = () => carouselEl.scrollBy({left: 280, behavior:"smooth"});

// gentle auto-slide, pauses on hover/touch
let autoSlide = setInterval(() => {
  carouselEl.scrollBy({left: 1.2, behavior:"auto"});
  if (carouselEl.scrollLeft + carouselEl.clientWidth >= carouselEl.scrollWidth - 2) {
    carouselEl.scrollTo({left:0, behavior:"smooth"});
  }
}, 40);
["mouseenter","touchstart"].forEach(ev => carouselEl.addEventListener(ev, ()
