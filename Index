<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>The Local Shop — Fresh finds, Best Prices</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700;9..144,900&family=Work+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js"></script>
<style>
  :root{
    --ink:#20241f;
    --paper:#f7f1e4;
    --paper-2:#efe6d2;
    --forest:#2f4a3c;
    --forest-dark:#20332a;
    --turmeric:#d9a13e;
    --terracotta:#c1543a;
    --line:#d8cba9;
    --radius:14px;
    --shadow:0 12px 30px rgba(32,36,31,.16);
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    background:var(--paper);
    color:var(--ink);
    font-family:'Work Sans',sans-serif;
    -webkit-font-smoothing:antialiased;
    overflow-x:hidden;
  }
  h1,h2,h3{font-family:'Fraunces',serif;margin:0;line-height:1.05;}
  .mono{font-family:'JetBrains Mono',monospace;}
  a{color:inherit;text-decoration:none;}
  button{font-family:inherit;cursor:pointer;border:none;}
  img{max-width:100%;display:block;}

  /* ---------- Top bar ---------- */
  .topbar{
    position:fixed;top:0;left:0;right:0;z-index:40;
    display:flex;align-items:center;justify-content:space-between;
    padding:14px 20px;
    background:rgba(247,241,228,.85);
    backdrop-filter:blur(6px);
    border-bottom:1px solid var(--line);
  }
  .topbar .brand{font-family:'Fraunces',serif;font-weight:700;font-size:1.15rem;letter-spacing:.2px;}
  .topbar .brand span{color:var(--terracotta);}
  .topbar nav{display:flex;gap:18px;font-size:.85rem;font-weight:600;}
  .topbar nav a{opacity:.75;}
  .topbar nav a:hover{opacity:1;}
  @media (max-width:560px){.topbar nav{display:none;}}

  /* ---------- Hero ---------- */
  .hero{
    position:relative;
    min-height:100vh;
    display:flex;
    align-items:flex-end;
    background:#111;
  }
  .hero img{
    position:absolute;inset:0;width:100%;height:100%;object-fit:cover;
  }
  .hero::after{
    content:"";position:absolute;inset:0;
    background:linear-gradient(180deg, rgba(20,22,18,.15) 0%, rgba(20,22,18,.55) 60%, rgba(20,22,18,.88) 100%);
  }
  .hero-content{
    position:relative;z-index:2;
    padding:0 24px 70px;
    max-width:720px;
    color:var(--paper);
  }
  .eyebrow{
    display:inline-block;
    font-family:'JetBrains Mono',monospace;
    font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;
    background:var(--turmeric);color:var(--ink);
    padding:5px 10px;border-radius:4px;margin-bottom:18px;
  }
  .hero h1{
    font-size:clamp(2.4rem,7vw,4.2rem);
    font-weight:900;
    letter-spacing:-.01em;
  }
  .hero p.tagline{
    margin-top:14px;font-size:clamp(1.05rem,2.4vw,1.3rem);
    color:var(--paper-2);max-width:520px;
  }
  .btn{
    display:inline-flex;align-items:center;gap:8px;
    padding:14px 26px;border-radius:999px;
    font-weight:700;font-size:.95rem;
    transition:transform .15s ease, box-shadow .15s ease;
  }
  .btn:active{transform:scale(.97);}
  .btn-primary{background:var(--turmeric);color:var(--ink);box-shadow:var(--shadow);}
  .btn-primary:hover{transform:translateY(-2px);}
  .btn-outline{background:transparent;border:1.5px solid var(--paper-2);color:var(--paper);}
  .hero-cta{margin-top:30px;}

  /* ---------- Ticker ---------- */
  .ticker{
    background:var(--forest);color:var(--paper);
    overflow:hidden;white-space:nowrap;
    border-top:1px solid var(--forest-dark);border-bottom:1px solid var(--forest-dark);
  }
  .ticker-track{
    display:inline-flex;gap:48px;padding:10px 0;
    animation:scroll-left 22s linear infinite;
  }
  .ticker-track span{font-family:'JetBrains Mono',monospace;font-size:.8rem;letter-spacing:.05em;}
  @keyframes scroll-left{from{transform:translateX(0);}to{transform:translateX(-50%);}}

  /* ---------- Section shell ---------- */
  section{padding:76px 20px;}
  .section-head{max-width:640px;margin:0 auto 36px;text-align:center;}
  .section-head .eyebrow{background:transparent;border:1px solid var(--forest);color:var(--forest);}
  .section-head h2{font-size:clamp(1.8rem,4vw,2.5rem);}
  .section-head p{margin-top:10px;color:#5a5648;}

  /* ---------- Product carousel ---------- */
  .carousel-wrap{max-width:1100px;margin:0 auto;position:relative;}
  .carousel{
    display:flex;gap:20px;overflow-x:auto;scroll-snap-type:x mandatory;
    padding:6px 6px 20px;scrollbar-width:none;
  }
  .carousel::-webkit-scrollbar{display:none;}
  .card{
    flex:0 0 auto;width:250px;scroll-snap-align:start;
    background:#fff;border-radius:var(--radius);overflow:hidden;
    box-shadow:var(--shadow);border:1px solid var(--line);
    display:flex;flex-direction:column;
  }
  .card .img-wrap{aspect-ratio:1/1;overflow:hidden;background:var(--paper-2);}
  .card .img-wrap img{width:100%;height:100%;object-fit:cover;}
  .card-body{padding:14px 16px 16px;display:flex;flex-direction:column;gap:8px;flex:1;}
  .card-body h3{font-size:1.05rem;font-weight:600;}
  .price-row{display:flex;align-items:center;justify-content:space-between;margin-top:auto;}
  .price{font-family:'JetBrains Mono',monospace;font-weight:700;color:var(--terracotta);font-size:1.05rem;}
  .add-btn{
    background:var(--forest);color:var(--paper);
    padding:9px 14px;border-radius:8px;font-size:.82rem;font-weight:700;
    transition:background .15s ease;
  }
  .add-btn:hover{background:var(--forest-dark);}
  .add-btn.added{background:var(--turmeric);color:var(--ink);}

  .carousel-arrows{display:flex;justify-content:center;gap:12px;margin-top:6px;}
  .arrow-btn{
    width:40px;height:40px;border-radius:50%;
    background:#fff;border:1px solid var(--line);
    display:flex;align-items:center;justify-content:center;font-size:1.1rem;
    box-shadow:var(--shadow);
  }
  .arrow-btn:hover{background:var(--paper-2);}

  /* ---------- About / visit ---------- */
  .about{background:var(--forest);color:var(--paper);}
  .about-grid{
    max-width:1000px;margin:0 auto;display:grid;grid-template-columns:1fr 1.1fr;gap:42px;align-items:center;
  }
  @media (max-width:760px){.about-grid{grid-template-columns:1fr;}}
  .photo-frame{
    background:#fff;padding:10px 10px 34px;border-radius:6px;
    box-shadow:0 20px 40px rgba(0,0,0,.35);
    transform:rotate(-2deg);
  }
  .photo-frame img{border-radius:2px;aspect-ratio:4/5;object-fit:cover;}
  .photo-frame figcaption{
    font-family:'JetBrains Mono',monospace;color:var(--ink);
    font-size:.72rem;text-align:center;margin-top:10px;letter-spacing:.05em;
  }
  .about h2{color:var(--paper);font-size:clamp(1.8rem,4vw,2.4rem);}
  .about p{color:var(--paper-2);margin-top:12px;line-height:1.6;}
  .about-list{list-style:none;margin:22px 0 0;padding:0;display:flex;flex-direction:column;gap:10px;}
  .about-list li{font-family:'JetBrains Mono',monospace;font-size:.85rem;display:flex;gap:10px;}
  .about-list li b{color:var(--turmeric);}

  /* ---------- Footer ---------- */
  footer{padding:40px 20px;text-align:center;color:#5a5648;font-size:.85rem;}
  footer a{color:var(--forest);font-weight:600;}

  /* ---------- Floating buttons ---------- */
  .fab{
    position:fixed;bottom:22px;z-index:50;
    width:58px;height:58px;border-radius:50%;
    display:flex;align-items:center;justify-content:center;
    box-shadow:var(--shadow);font-size:1.5rem;
  }
  .fab-cart{right:22px;background:var(--terracotta);color:#fff;}
  .fab-wa{left:22px;background:#25D366;color:#fff;}
  .cart-count{
    position:absolute;top:-6px;right:-6px;
    background:var(--ink);color:#fff;
    font-family:'JetBrains Mono',monospace;font-size:.68rem;font-weight:700;
    width:22px;height:22px;border-radius:50%;
    display:flex;align-items:center;justify-content:center;
  }

  /* ---------- Cart drawer (receipt style) ---------- */
  .overlay{
    position:fixed;inset:0;background:rgba(20,22,18,.5);z-index:60;
    opacity:0;pointer-events:none;transition:opacity .25s ease;
  }
  .overlay.open{opacity:1;pointer-events:auto;}
  .drawer{
    position:fixed;top:0;right:0;height:100%;width:min(420px,100%);
    background:#fffdf7;z-index:61;
    transform:translateX(100%);transition:transform .3s ease;
    display:flex;flex-direction:column;
    box-shadow:-10px 0 30px rgba(0,0,0,.25);
  }
  .drawer.open{transform:translateX(0);}
  .drawer-zigzag-top, .drawer-zigzag-bottom{
    height:14px;
    background:linear-gradient(135deg, #fffdf7 50%, transparent 50%) 0 0/14px 14px repeat-x,
               linear-gradient(-135deg, #fffdf7 50%, transparent 50%) 0 0/14px 14px repeat-x;
    background-color:var(--ink);
  }
  .drawer-head{
    padding:20px 22px 12px;display:flex;align-items:center;justify-content:space-between;
    border-bottom:1px dashed #c9bd9a;
  }
  .drawer-head h3{font-family:'JetBrains Mono',monospace;font-size:1rem;letter-spacing:.05em;}
  .close-btn{background:none;font-size:1.3rem;color:var(--ink);opacity:.6;}
  .close-btn:hover{opacity:1;}
  .drawer-body{flex:1;overflow-y:auto;padding:16px 22px;font-family:'JetBrains Mono',monospace;}
  .empty-msg{text-align:center;color:#a0977c;padding:40px 0;font-size:.85rem;}
  .cart-line{
    display:flex;align-items:center;gap:10px;padding:10px 0;
    border-bottom:1px dotted #d8cba9;font-size:.82rem;
  }
  .cart-line img{width:42px;height:42px;object-fit:cover;border-radius:4px;flex:0 0 auto;}
  .cart-line .name{flex:1;min-width:0;}
  .cart-line .name div:first-child{font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
  .qty-controls{display:flex;align-items:center;gap:6px;}
  .qty-controls button{
    width:22px;height:22px;border-radius:4px;background:var(--paper-2);
    font-weight:700;font-size:.85rem;display:flex;align-items:center;justify-content:center;
  }
  .line-total{width:64px;text-align:right;font-weight:700;}
  .remove-x{color:var(--terracotta);opacity:.7;font-weight:700;margin-left:2px;}
  .remove-x:hover{opacity:1;}

  .cart-subtotal{
    display:flex;justify-content:space-between;padding:14px 0 0;
    font-family:'JetBrains Mono',monospace;font-weight:700;font-size:.95rem;
    border-top:1px dashed #c9bd9a;margin-top:10px;
  }

  .order-form{padding:16px 22px 4px;border-top:1px dashed #c9bd9a;font-family:'Work Sans',sans-serif;}
  .order-form label{
    display:block;font-size:.72rem;font-weight:700;text-transform:uppercase;
    letter-spacing:.06em;color:#6b6551;margin:12px 0 5px;
  }
  .order-form input, .order-form textarea{
    width:100%;padding:10px 12px;border:1px solid var(--line);border-radius:8px;
    font-family:'Work Sans',sans-serif;font-size:.9rem;background:#fff;
  }
  .order-form textarea{resize:vertical;min-height:56px;}
  .send-btn{
    width:100%;margin-top:16px;padding:13px;border-radius:999px;
    background:var(--forest);color:var(--paper);font-weight:700;font-size:.9rem;
    letter-spacing:.02em;
  }
  .send-btn:hover{background:var(--forest-dark);}
  .send-btn:disabled{opacity:.6;cursor:not-allowed;}
  .form-note{font-size:.72rem;color:#a0977c;margin:14px 0 18px;text-align:center;}
  .status-msg{
    margin:10px 0 0;font-size:.8rem;padding:10px 12px;border-radius:8px;display:none;
  }
  .status-msg.show{display:block;}
  .status-msg.ok{background:#e4f0e6;color:var(--forest-dark);}
  .status-msg.err{background:#f7e3df;color:var(--terracotta);}
</style>
</head>
<body>

<div class="topbar">
